# =============================================================================
# .gitignore - Clinical Note Analysis Project
# =============================================================================

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# =============================================================================
# IDE and Editors
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# =============================================================================
# Jupyter Notebooks
# =============================================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# =============================================================================
# Data Files (DO NOT COMMIT - Contains PHI)
# =============================================================================
data/
*.csv
*.parquet
*.json
!config.json
!reference_data/*.csv

# Raw MIMIC-IV data
raw_data/
MIMIC-IV_raw_data/
mimic-iv/

# =============================================================================
# Model Checkpoints and Outputs
# =============================================================================
checkpoints/
models/
outputs/
logs/
*.pt
*.pth
*.bin
*.safetensors
*.gguf

# Best checkpoint config (generated)
best_checkpoint.json

# =============================================================================
# SLURM and HPC
# =============================================================================
slurm-*.out
*.out
*.err
job_*.sh

# =============================================================================
# Hugging Face Cache
# =============================================================================
.cache/
~/.cache/huggingface/

# =============================================================================
# OS Generated Files
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# Logs and Temporary Files
# =============================================================================
*.log
*.tmp
*.temp
*.bak

# =============================================================================
# Secrets and Credentials (NEVER COMMIT)
# =============================================================================
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.json
config.local.py

# =============================================================================
# Deprecated Files (old scripts, outputs, logs)
# =============================================================================
deprecated_files/
deprecated/

# =============================================================================
# Project-Specific Exclusions
# =============================================================================
# UIC external validation script (proprietary data paths)
15_UIC_Bootstrap.py

# Experimental fine-tuning variants (not part of main pipeline)
4_FineTuning_Extended_*.py
4_FineTuning_Resume.py

# Internal manuscript-revision verification (not a standalone public script)
16_FactorialReplication.py

# Shell pipeline scripts (contain local paths)
run_pipeline*.sh
run_reeval*.sh

# SLURM job scripts (HPC-specific)
slurm_scripts/

# Claude Code settings
.claude/
CLAUDE.md

# Manuscript drafts
manuscript_*.txt

# Confidential peer-review material and session notes
old_session_prompts.md
_reviewer_response_drafts/

# Private workstation/session files and manuscript drafts (never commit)
RESTORE.md
environment_freeze.txt
manuscript/
claude_state/

# Detailed results (numbers may drift ahead of the published manuscript)
RESULTS.md

# Unsloth cache
unsloth_compiled_cache/

# Raw data symlink
raw_data
